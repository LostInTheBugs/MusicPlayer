#include <windows.h>
IDI_MUSICPLAYER ICON "musicplayer.ico"

/* Dialog "Plugins" (Settings ▸ Plugins…) — ID numérique 105 */
105 DIALOG 0, 0, 380, 246
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Plugins"
FONT 8, "MS Shell Dlg"
BEGIN
