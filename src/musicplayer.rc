    CONTROL "", 2005, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 14, 26, 352, 184
    PUSHBUTTON "Delete selected...", 2006, 14, 218, 106, 16
    DEFPUSHBUTTON "OK", 1, 200, 218, 60, 16
    PUSHBUTTON "Cancel", 2, 270, 218, 60, 16
END

