    GROUPBOX "Full screen", 1032, 12, 68, 316, 206
    LTEXT "Screens used for full screen :", 1033, 24, 86, 190, 10
    COMBOBOX 1040, 220, 83, 96, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Screen 2 shows :", 1034, 24, 112, 190, 10
    COMBOBOX 1041, 220, 109, 96, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Screen 3 shows :", 1035, 24, 138, 190, 10
    COMBOBOX 1042, 220, 135, 96, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Screen 4 shows :", 1036, 24, 164, 190, 10
    COMBOBOX 1043, 220, 161, 96, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", 1037, 24, 190, 290, 10
    GROUPBOX "Start with Windows (login)", 1050, 12, 282, 316, 44
    PUSHBUTTON "Enable autostart", 1044, 24, 298, 140, 16
    PUSHBUTTON "Start engine now", 1046, 176, 298, 140, 16
    DEFPUSHBUTTON "OK", IDOK, 192, 336, 70, 18
    PUSHBUTTON "Cancel", IDCANCEL, 272, 336, 70, 18
END

/* Dialog "Update" (Settings ▸ Update…) — ID numérique 109 */
109 DIALOG 0, 0, 320, 294
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Update"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Update mode", 1017, 12, 8, 296, 96
    AUTORADIOBUTTON "Automatic (check at startup)", 1018, 24, 24, 272, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Manual", 1019, 24, 40, 272, 12
    AUTORADIOBUTTON "Disabled", 1020, 24, 56, 272, 12
    AUTORADIOBUTTON "Fully automatic (check hourly, apply and restart)", 1022, 24, 72, 272, 12
    GROUPBOX "Update type", 1023, 12, 110, 296, 44
    AUTORADIOBUTTON "All updates", 1024, 24, 126, 130, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Fixes only (-cX)", 1025, 160, 126, 130, 12
    GROUPBOX "Plugins", 2004, 12, 160, 296, 44
    AUTORADIOBUTTON "Update plugins with the program", 2003, 24, 176, 272, 12, WS_GROUP | WS_TABSTOP
    GROUPBOX "Delay before applying / notifying", 1026, 12, 210, 296, 44
    AUTORADIOBUTTON "None", 1027, 24, 226, 56, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "1 day", 1028, 88, 226, 56, 12
    AUTORADIOBUTTON "1 week", 1029, 150, 226, 64, 12
    AUTORADIOBUTTON "1 month", 1030, 222, 226, 70, 12
    PUSHBUTTON "Check now...", 1021, 12, 264, 92, 18
    DEFPUSHBUTTON "OK", IDOK, 158, 264, 70, 18
    PUSHBUTTON "Cancel", IDCANCEL, 238, 264, 70, 18
END

