/* Dialog "Interface" (Settings ▸ Interface…) — ID numérique 108 */
108 DIALOG 0, 0, 340, 368
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Interface"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Skin", 1015, 12, 16, 60, 10
    COMBOBOX 1013, 76, 13, 250, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Language", 1016, 12, 46, 60, 10
