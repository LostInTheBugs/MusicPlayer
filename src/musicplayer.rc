#include <windows.h>
IDI_MUSICPLAYER ICON "musicplayer.ico"

/* Dialog "Plugins" (Settings ▸ Plugins…) — ID numérique 105 */
105 DIALOG 0, 0, 380, 246
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Plugins"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Activate or deactivate plugins :", 1004, 14, 12, 220, 12
    CONTROL "", 2005, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 14, 26, 352, 184
    DEFPUSHBUTTON "OK", 1, 130, 218, 60, 16
    PUSHBUTTON "Cancel", 2, 200, 218, 60, 16
END

/* Dialog "Mise à jour disponible" — ID numérique 106 */
106 DIALOG 0, 0, 330, 132
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Update available"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "A new version is available :", 1005, 14, 12, 302, 40
    DEFPUSHBUTTON "Update now", 1, 14, 64, 96, 16
    PUSHBUTTON "Later", 2, 118, 64, 96, 16
    PUSHBUTTON "Skip this version", 3, 222, 64, 96, 16
END
/* Dialog "À propos" — ID numérique 107 */
107 DIALOG 0, 0, 330, 140
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", 1006, 14, 14, 302, 16
    LTEXT "", 1007, 14, 34, 302, 16
    LTEXT "https://github.com/LostInTheBugs/MusicPlayer", 1008, 14, 56, 302, 16
    DEFPUSHBUTTON "OK", 1, 100, 108, 60, 16
    PUSHBUTTON "Open GitHub", 2, 170, 108, 96, 16
END

104 DIALOG 0, 0, 300, 244
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Web server"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "Enable web server", 2001, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 12, 220, 14
    LTEXT "Port:", 1001, 14, 40, 50, 12
    EDITTEXT 2002, 70, 38, 56, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "Audio output:", 1002, 14, 66, 90, 12
    COMBOBOX 2003, 108, 64, 160, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Listen on:", 1003, 14, 94, 60, 12
    CONTROL "", 2004, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 14, 108, 272, 102
    DEFPUSHBUTTON "OK", 1, 92, 218, 60, 16
    PUSHBUTTON "Cancel", 2, 162, 218, 60, 16
END
